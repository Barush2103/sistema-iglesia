generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Ciclo {
  id        Int       @id @default(autoincrement())
  nombre    String    // "2026-2027"
  activo    Boolean   @default(false)
  alumnos   Alumno[]
  colectas  Colecta[]
  createdAt DateTime  @default(now())
}

model Alumno {
  id              Int          @id @default(autoincrement())
  nombre          String
  nivel           Nivel
  catequista      String?
  dia             String?
  responsable     String?
  telefonoCasa    String?
  telefonoCelular String?
  cicloId         Int
  ciclo           Ciclo        @relation(fields: [cicloId], references: [id])
  documentos      Documento[]
  pagos           Pago[]
  aportaciones    Aportacion[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Documento {
  id        Int       @id @default(autoincrement())
  alumnoId  Int
  alumno    Alumno    @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  tipo      String
  entregado Boolean   @default(false)
  fecha     DateTime?
  notas     String?
  createdAt DateTime  @default(now())
}

model Pago {
  id        Int       @id @default(autoincrement())
  alumnoId  Int
  alumno    Alumno    @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  tipo      String
  monto     Float?
  pagado    Boolean   @default(false)
  fecha     DateTime?
  notas     String?
  createdAt DateTime  @default(now())
}

model Colecta {
  id           Int          @id @default(autoincrement())
  nombre       String
  descripcion  String?
  meta         Float?
  activa       Boolean      @default(true)
  cicloId      Int
  ciclo        Ciclo        @relation(fields: [cicloId], references: [id])
  aportaciones Aportacion[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Aportacion {
  id        Int      @id @default(autoincrement())
  colectaId Int
  colecta   Colecta  @relation(fields: [colectaId], references: [id], onDelete: Cascade)
  alumnoId  Int?
  alumno    Alumno?  @relation(fields: [alumnoId], references: [id], onDelete: SetNull)
  nombre    String
  monto     Float
  notas     String?
  fecha     DateTime @default(now())
  createdAt DateTime @default(now())
}

model Config {
  id        Int      @id @default(autoincrement())
  clave     String   @unique
  valor     String
  updatedAt DateTime @updatedAt
}

enum Nivel {
  PRECOMUNION
  COMUNION
  PRECONFIRMACION
  CONFIRMACION
}
